{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "integration_run_id",
    "scenario_id",
    "feature_id",
    "created_at",
    "inputs",
    "execution",
    "result"
  ],
  "properties": {
    "integration_run_id": {
      "type": "string",
      "pattern": "^IR-[A-Z0-9-]+-[0-9A-Fa-f-]+$"
    },
    "scenario_id": {
      "type": "string"
    },
    "feature_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "type": "object",
      "required": [
        "provider",
        "consumer",
        "contracts"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/repoInput"
        },
        "consumer": {
          "$ref": "#/$defs/repoInput"
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "contract_id",
              "version"
            ],
            "properties": {
              "contract_id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "endpoint_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "repository",
        "workflow",
        "workflow_run_id",
        "runner"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "workflow": {
          "type": "string"
        },
        "workflow_run_id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "runner": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "RUNNING",
            "PASS",
            "FAIL"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stdout_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "stderr_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "repoInput": {
      "type": "object",
      "required": [
        "repository_id",
        "commit"
      ],
      "properties": {
        "repository_id": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "release": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
