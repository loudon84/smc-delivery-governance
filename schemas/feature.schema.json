{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["feature_id", "title", "program_id", "status", "participants", "global_changes", "work_packages"],
  "properties": {
    "feature_id": {"type": "string", "pattern": "^FEAT-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "program_id": {"type": "string"},
    "status": {"enum": ["PROPOSED", "ARCHITECTURE", "PLANNED", "IMPLEMENTING", "INTEGRATING", "VERIFYING", "DONE", "BLOCKED", "CANCELLED"]},
    "architecture_revision": {"type": "string"},
    "feature_owner": {"type": "string"},
    "integration_owner": {"type": "string"},
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["repository_id", "role"],
        "properties": {
          "repository_id": {"type": "string"},
          "role": {"enum": ["provider", "consumer", "shared", "observer"]}
        },
        "additionalProperties": false
      }
    },
    "global_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^XR-C[0-9]{2,}$"},
          "title": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contract_id", "provider_repository", "consumer_repositories", "required_version", "current_state"],
        "properties": {
          "contract_id": {"type": "string"},
          "provider_repository": {"type": "string"},
          "consumer_repositories": {"type": "array", "items": {"type": "string"}},
          "required_version": {"type": "string"},
          "required_state_for_dark_implementation": {"type": "string"},
          "required_state_for_production_start": {"type": "string"},
          "current_state": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "work_packages": {"type": "array", "items": {"type": "string"}},
    "integration": {"type": "object"}
  },
  "additionalProperties": false
}
