{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "integration_run_id",
    "scenario_id",
    "feature_id",
    "status",
    "exit_code",
    "duration_ms",
    "stdout_sha256",
    "stderr_sha256",
    "generated_at"
  ],
  "properties": {
    "integration_run_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "feature_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "duration_ms": {
      "type": "integer"
    },
    "stdout_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stderr_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
