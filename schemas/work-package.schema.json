{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "work_package_id",
    "feature_id",
    "repository_id",
    "role",
    "status",
    "outcome",
    "global_change_ids",
    "acceptance",
    "evidence_required",
    "source_revision",
    "sync_state"
  ],
  "properties": {
    "work_package_id": {
      "type": "string",
      "pattern": "^WP-[A-Z0-9-]+$"
    },
    "feature_id": {
      "type": "string"
    },
    "repository_id": {
      "type": "string"
    },
    "role": {
      "enum": [
        "provider",
        "consumer",
        "shared"
      ]
    },
    "status": {
      "enum": [
        "BACKLOG",
        "READY",
        "IN_PRD",
        "PLANNED",
        "IMPLEMENTING",
        "REVIEW",
        "VERIFIED",
        "DONE",
        "BLOCKED",
        "SUPERSEDED"
      ]
    },
    "owner": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "minLength": 10
    },
    "global_change_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^XR-C[0-9]{2,}$"
      }
    },
    "contract_inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "contract_outputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_delivery": {
      "type": "object"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "sync_state": {
      "enum": [
        "UNKNOWN",
        "SYNCED",
        "STALE_FEATURE",
        "STALE_CONTRACT",
        "MISSING_RECEIPT",
        "DIVERGED"
      ]
    },
    "delivery_receipt": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
