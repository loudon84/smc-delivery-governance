{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["feature_id", "source_prd", "work_packages"],
  "properties": {
    "feature_id": {"type": "string"},
    "source_prd": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string"},
        "repository_id": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "revision": {"type": "string"}
      },
      "additionalProperties": false
    },
    "work_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work_package_id", "repository_id"],
        "properties": {
          "work_package_id": {"type": "string"},
          "repository_id": {"type": "string"},
          "stage_prds": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
          "issues": {"type": "array"},
          "bugs": {"type": "array"},
          "plans": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
          "commits": {"type": "array", "items": {"type": "string"}},
          "verification": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["path", "status"],
      "properties": {
        "artifact_id": {"type": "string"},
        "repository_id": {"type": "string"},
        "path": {"type": "string"},
        "artifact_type": {"type": "string"},
        "status": {"type": "string"},
        "commit": {"type": "string"},
        "source_revision": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
