{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["feature_id", "source_prd", "work_packages"],
  "properties": {
    "feature_id": {"type": "string"},
    "source_prd": {"$ref": "#/$defs/artifactRef"},
    "work_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work_package_id", "repository_id"],
        "properties": {
          "work_package_id": {"type": "string"},
          "repository_id": {"type": "string"},
          "stage_prds": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
          "issues": {"type": "array"},
          "bugs": {"type": "array"},
          "plans": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
          "commits": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
          },
          "verification": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": [
        "repository_id",
        "path",
        "commit",
        "blob_sha",
        "sha256",
        "artifact_type",
        "artifact_id",
        "status",
        "source_revision"
      ],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\./).+"},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "blob_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "artifact_type": {
          "enum": ["SOURCE_PRD", "STAGE_PRD", "PLAN", "VERIFICATION", "BUILD", "RELEASE"]
        },
        "artifact_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
