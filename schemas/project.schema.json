{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["project_id", "name", "status", "repositories"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^PROJECT-[A-Z0-9-]+$"},
    "name": {"type": "string"},
    "status": {"enum": ["ACTIVE", "PAUSED", "RETIRED"]},
    "repositories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "domains": {"type": "array", "items": {"type": "string"}},
    "interfaces_provided": {"type": "array", "items": {"type": "string"}},
    "interfaces_consumed": {"type": "array", "items": {"type": "string"}},
    "team": {"type": "string"}
  },
  "additionalProperties": false
}
