# Local secrets for SMC Delivery Governance tools.
# Copy to `.env` and fill values. `.env` is gitignored.
# Existing process environment and GitHub Actions secrets take precedence.

# Central repository: GitHub API for ArtifactRef verify, remote bootstrap,
# kit fetch, acceptance attestation, and project-status sync.
SMC_GOVERNANCE_GITHUB_TOKEN=

# Project repositories: dispatch `smc-governance-sync` / acceptance events
# to loudon84/smc-delivery-governance.
SMC_GOVERNANCE_DISPATCH_TOKEN=

# Optional IntegrationRun secrets. Only required when the integration gate is
# READY and a real runner is executed. Empty history is valid until then.
# SMC_SKILL_RUN_BASE_URL=
# SMC_SKILL_RUN_TOKEN=
# SMC_SKILL_NAME=
