{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smc.ges.consumer-remediation-plan.v1",
  "title": "GES Consumer Remediation Plan",
  "type": "object",
  "required": [
    "schema",
    "project",
    "created_at",
    "actions",
    "ok"
  ],
  "properties": {
    "schema": { "const": "smc.ges.consumer-remediation-plan.v1" },
    "project": { "type": "string" },
    "created_at": { "type": "string" },
    "ok": { "type": "boolean" },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "target", "reason"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["WRITE_TEMPLATE", "RUN_COMMAND", "MANUAL"] },
          "target": { "type": "string" },
          "template": { "type": "string" },
          "command": { "type": "string" },
          "reason": { "type": "string" },
          "claim": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "forbidden": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
