{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smc.ges.consumer-audit.v1",
  "title": "GES Consumer Audit Report",
  "type": "object",
  "required": [
    "schema",
    "project",
    "audited_at",
    "layers",
    "checks",
    "ok"
  ],
  "properties": {
    "schema": { "const": "smc.ges.consumer-audit.v1" },
    "project": { "type": "string" },
    "audited_at": { "type": "string" },
    "ok": { "type": "boolean" },
    "layers": {
      "type": "object",
      "required": ["ges", "spec_kit", "superpowers"],
      "properties": {
        "ges": { "$ref": "#/$defs/layer" },
        "spec_kit": { "$ref": "#/$defs/layer" },
        "superpowers": { "$ref": "#/$defs/layer" }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "layer", "present", "path"],
        "properties": {
          "id": { "type": "string" },
          "layer": { "type": "string" },
          "present": { "type": "boolean" },
          "path": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "probe": { "type": "object" }
  },
  "additionalProperties": true,
  "$defs": {
    "layer": {
      "type": "object",
      "required": ["verdict", "present", "total", "missing"],
      "properties": {
        "verdict": { "enum": ["PASS", "PARTIAL", "MISSING"] },
        "present": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "missing": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  }
}
