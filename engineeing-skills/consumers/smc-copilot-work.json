{
  "schema": "smc.ges.consumer-profile.v3",
  "id": "smc-copilot-work",
  "version": "2.0.0",
  "mirror_policy": "managed-set",
  "test_asset_root": "docs_agent/test-assets",
  "domains": {
    "frontend": {
      "activation": "auto"
    },
    "backend": {
      "activation": "auto"
    },
    "ops": {
      "activation": "auto"
    }
  },
  "required_paths": [
    ".agents/skills",
    ".agents/skills/code-review-and-quality/SKILL.md",
    ".agents/skills/verification-before-completion/SKILL.md",
    "package.json"
  ],
  "project_validator": "python tools/agent-skills/validate_agent_skills.py",
  "quality_commands": {
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "unit": "npm test",
    "build": "npm run build",
    "visual": "npm run test:live-visual",
    "knowledge": "npx lat check"
  },
  "consumer_skills": {
    "preserve": [
      "electron-pro",
      "typescript-expert",
      "lat-md",
      "hermes-agent"
    ]
  },
  "project_policy_paths": [
    "AGENTS.md"
  ],
  "execution_policy": {
    "model_tiers": {
      "FAST": "fast",
      "STANDARD": "standard",
      "REASONING": "reasoning"
    }
  }
}
