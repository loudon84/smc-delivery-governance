{
  "schema": "smc.ges.consumer-profile.v3",
  "id": "nodeskclaw",
  "version": "2.0.0",
  "mirror_policy": "full-tree",
  "test_asset_root": "docs_agent/test-assets",
  "domains": {
    "frontend": {
      "activation": "auto"
    },
    "backend": {
      "activation": "auto"
    },
    "ops": {
      "activation": "auto"
    }
  },
  "required_paths": [
    ".agents/skills",
    ".agents/skills/code-review-and-quality/SKILL.md",
    ".agents/skills/verification-before-completion/SKILL.md",
    ".agents/skills/smc-plan-validator/scripts/validate_plan.py",
    "tools/agent-skills/validate_agent_skills.py"
  ],
  "project_validator": "python tools/agent-skills/validate_agent_skills.py",
  "quality_commands": {},
  "project_policy_paths": [
    "AGENTS.md"
  ],
  "execution_policy": {
    "model_tiers": {
      "FAST": "fast",
      "STANDARD": "standard",
      "REASONING": "reasoning"
    }
  }
}
