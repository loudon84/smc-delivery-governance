{
  "schema": "smc.ges.domain-activation-rules.v1",
  "extensions": [".tsx", ".jsx", ".css", ".scss", ".less", ".html"],
  "path_globs": [
    "**/renderer/**",
    "**/components/**",
    "**/screens/**",
    "**/pages/**",
    "**/views/**",
    "**/ui/**"
  ],
  "target_tokens": [
    "renderer_ui",
    "react_component",
    "css_theme",
    "interaction"
  ],
  "exclude_globs": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/generated/**",
    "**/dist/**",
    "**/out/**"
  ]
}
